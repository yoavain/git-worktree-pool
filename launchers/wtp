#!/bin/sh
# wtp-launcher 3
# Written by "worktree-pool setup". It runs worktree-pool. A script cannot change its caller's
# folder; the wtp function in your shell profile does that. WTP_VIA tells worktree-pool which hint to show.
command -v worktree-pool >/dev/null 2>&1 || { echo "wtp: worktree-pool is not installed. Reinstall git-worktree-pool, or delete $0." >&2; exit 127; }
WTP_VIA=sh exec worktree-pool "$@"
